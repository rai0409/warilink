# このリポジトリは何もインストールしない(STEP 04)。導入先の運用者が確認してから入れる:
#   sudo install -m 644 infra/systemd/warilink-*.service infra/systemd/warilink-*.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now warilink-purge.timer warilink-backup.timer warilink-monitor.timer warilink-restore-verify.timer
# 前提: リポジトリは /srv/warilink、実行ユーザー warilink(docker グループ。docker を使えるのは root 相当なので専用にする)、
# /etc/warilink/production.env(compose の秘密、600)と /etc/warilink/jobs.env(ジョブの設定、600)。
# infra/ops/warilink-purge.cron.example の cron と同時に使わない(二重の実行になる)。手順は infra/ops/production-runbook.md。
#
# 暗号化バックアップ(STEP 01〜03): pg_dump は読み取り専用のロール warilink_backup、成否の記録は warilink_app。
# 外部保管(S3)への送信と、記録した世代の読み戻しの検証まで成功したときだけ成功(終了コード 0)。
# 出力(受領記録の世代と SHA-256 を含む)は /var/lib/warilink/last-backup.json に残し、復元の検証で使う。
# 成功したら、保持日数(30 日)を過ぎたローカルのバックアップを消す(外部保管の期限はライフサイクル規則)。

[Unit]
Description=WariLink encrypted offsite backup
Documentation=file:///srv/warilink/infra/ops/production-runbook.md
Requires=docker.service
After=docker.service network-online.target warilink-purge.service
Wants=network-online.target
StartLimitIntervalSec=12h
StartLimitBurst=2

[Service]
Type=oneshot
User=warilink
Group=warilink
WorkingDirectory=/srv/warilink
EnvironmentFile=/etc/warilink/production.env
Environment=WARILINK_ENVIRONMENT=production
StateDirectory=warilink
StateDirectoryMode=0700
ExecStartPre=/bin/mkdir -p /var/lib/warilink/backups /var/lib/warilink/receipts-snapshot
# 受領記録を含む出力は、成功したときだけ last-backup.json に置き換える(失敗の出力で上書きしない)
ExecStart=/bin/sh -c '/srv/warilink/.venv/bin/python scripts/warilink_backup.py --container warilink-prod-db-1 --user warilink_backup --record-user warilink_app backup --db warilink --receipts-dir /var/lib/warilink/receipts-snapshot --out /var/lib/warilink/backups/$$(date -u +%%Y%%m%%dT%%H%%M%%SZ) > /var/lib/warilink/last-backup.tmp && mv /var/lib/warilink/last-backup.tmp /var/lib/warilink/last-backup.json'
ExecStartPost=/srv/warilink/.venv/bin/python scripts/warilink_backup.py prune --root /var/lib/warilink/backups
TimeoutStartSec=2h
Restart=on-failure
RestartSec=30min
Nice=10
UMask=0077
NoNewPrivileges=yes
# docker のソケット(root 相当)を使うため、それ以外の権限はできるだけ外す
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
SyslogIdentifier=warilink-backup
